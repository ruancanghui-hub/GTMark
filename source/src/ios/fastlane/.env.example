# 复制为 .env 后填写真实值：cp .env.example .env
# 不要将 .env 或 .p8 提交到版本库。

# App Store Connect API（Fastfile asc_api_key）
ASC_KEY_ID=
ASC_ISSUER_ID=
# 推荐：指向 fastlane 目录下的 .p8 文件名（避免 ASC_KEY_CONTENT 多行在 .env 里被截断）
ASC_KEY_FILE=AuthKey_XXXXXXXX.p8
# 若不使用 ASC_KEY_FILE，再填下面二选一（整段 PEM 或 Base64）
ASC_KEY_CONTENT=
ASC_KEY_IS_BASE64=false

# Flutter ipa 版本：默认读取仓库根目录 pubspec.yaml 的 version（当前示例 2.0.2+4）
# 仅当要用临时覆盖时再取消注释：
# IOS_BUILD_NAME=2.0.2
# IOS_BUILD_NUMBER=4

# App Store Connect：默认只上传二进制，不把版本送审（在 ASC 后台选手动提交）
# 若要 lane 直接送审并自动上架，先确认元数据就绪再设 true：
# SUBMIT_FOR_REVIEW=true
# AUTOMATIC_RELEASE=false

# 与 Xcode PRODUCT_BUNDLE_IDENTIFIER 一致（Appfile app_identifier）
IOS_BUNDLE_ID=com.nightelf.LuckyDatePro

# 可选：默认已在 Appfile 中
# FASTLANE_APPLE_ID=bfqiwbifj@163.com
# IOS_TEAM_ID=JH8478GAY6

# 可选：IPA 路径（默认 ../build/ios/ipa/Runner.ipa）
# IOS_IPA_PATH=

# 同一 Apple ID 多团队时使用
# APP_STORE_CONNECT_TEAM_ID=
# APP_STORE_CONNECT_TEAM_NAME=
