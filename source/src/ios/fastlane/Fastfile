default_platform(:ios)

# Flutter 产物多为 *.ipa（如 LuckyDatePro.ipa），未必是 Runner.ipa
# 注意：fastlane 运行时 cwd 常为 ios/fastlane，不能用 Dir.pwd 拼 build 路径
def resolve_build_ipa_path
  fastlane_dir = __dir__
  ios_dir = File.expand_path("..", fastlane_dir)
  project_root = File.expand_path("..", ios_dir)
  if ENV["IOS_IPA_PATH"] && !ENV["IOS_IPA_PATH"].strip.empty?
    path = File.expand_path(ENV["IOS_IPA_PATH"], ios_dir)
  else
    dir = File.join(project_root, "build", "ios", "ipa")
    hits = Dir.glob(File.join(dir, "*.ipa"))
    UI.user_error!("找不到 IPA，请先构建或设置 IOS_IPA_PATH（已搜 #{dir}/*.ipa）") if hits.empty?
    path = hits.max_by { |f| File.mtime(f) }
  end
  UI.user_error!("IPA 路径无效: #{path}") unless File.file?(path)
  path
end

def resolve_flutter_build_version
  fastlane_dir = __dir__
  ios_dir = File.expand_path("..", fastlane_dir)
  project_root = File.expand_path("..", ios_dir)
  pubspec_path = File.join(project_root, "pubspec.yaml")
  UI.user_error!("未找到 pubspec.yaml: #{pubspec_path}") unless File.file?(pubspec_path)

  line = File.readlines(pubspec_path).find { |l| l.strip.start_with?("version:") }
  UI.user_error!("pubspec.yaml 缺少 version 字段") if line.nil?

  value = line.split(":", 2).last.to_s.strip
  name, number = value.split("+", 2)
  UI.user_error!("pubspec.yaml version 格式无效: #{value}") if name.to_s.empty? || number.to_s.empty?
  [name, number]
end

platform :ios do
  private_lane :ensure_asc_credentials! do
    has_ids = ENV["ASC_KEY_ID"].to_s.strip != "" && ENV["ASC_ISSUER_ID"].to_s.strip != ""
    has_key = ENV["ASC_KEY_FILE"].to_s.strip != "" || ENV["ASC_KEY_CONTENT"].to_s.strip != ""
    return if has_ids && has_key

    UI.user_error!(
      "缺少 App Store Connect API 凭证。请复制 fastlane/.env.example 为 fastlane/.env，" \
      "填写 ASC_KEY_ID、ASC_ISSUER_ID，并将 AuthKey_*.p8 放到 fastlane/ 目录（ASC_KEY_FILE）。"
    )
  end

  private_lane :asc_api_key do
    ensure_asc_credentials!
    key_file = ENV["ASC_KEY_FILE"].to_s.strip
    if !key_file.empty?
      path = File.expand_path(key_file, __dir__)
      UI.user_error!("ASC_KEY_FILE 不存在: #{path}") unless File.file?(path)
      app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_filepath: path
      )
    else
      app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_content: ENV.fetch("ASC_KEY_CONTENT"),
        is_key_content_base64: ENV.fetch("ASC_KEY_IS_BASE64", "false") == "true"
      )
    end
  end

  private_lane :prepare_flutter do
    # Flutter 子进程需找到 Homebrew 的 pod，否则会报 CocoaPods broken（Ruby 不一致）
    if File.directory?("/opt/homebrew/bin")
      ENV["PATH"] = "/opt/homebrew/bin:/opt/homebrew/sbin:#{ENV.fetch('PATH', '')}"
    end

    build_name, build_number = resolve_flutter_build_version
    build_name = ENV["IOS_BUILD_NAME"].to_s.strip.empty? ? build_name : ENV["IOS_BUILD_NAME"].to_s.strip
    build_number = ENV["IOS_BUILD_NUMBER"].to_s.strip.empty? ? build_number : ENV["IOS_BUILD_NUMBER"].to_s.strip

    UI.message("使用 build-name=#{build_name}, build-number=#{build_number}")
    sh("cd .. && flutter --version")
    sh("cd .. && flutter pub get")
    sh("cd .. && flutter build ipa --release --export-method app-store --build-name=#{build_name} --build-number=#{build_number}")
  end

  desc "构建并上传到 TestFlight"
  lane :beta do
    api_key = asc_api_key
    prepare_flutter

    upload_to_testflight(
      api_key: api_key,
      ipa: resolve_build_ipa_path,
      skip_waiting_for_build_processing: ENV.fetch("SKIP_WAIT_FOR_PROCESSING", "true") == "true",
      distribute_external: ENV.fetch("TESTFLIGHT_EXTERNAL", "false") == "true",
      changelog: ENV["TESTFLIGHT_CHANGELOG"]
    )
  end

  private_lane :deliver_ipa do
    deliver(
      api_key: asc_api_key,
      ipa: resolve_build_ipa_path,
      skip_metadata: ENV.fetch("SKIP_METADATA", "true") == "true",
      skip_screenshots: ENV.fetch("SKIP_SCREENSHOTS", "true") == "true",
      force: true,
      submit_for_review: ENV.fetch("SUBMIT_FOR_REVIEW", "false") == "true",
      automatic_release: ENV.fetch("AUTOMATIC_RELEASE", "false") == "true",
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "仅上传已构建的 IPA（跳过 flutter build，需先 flutter build ipa）"
  lane :upload do
    deliver_ipa
  end

  desc "构建并提交 App Store 审核（默认不自动提交）"
  lane :release do
    prepare_flutter
    deliver_ipa
  end
end
